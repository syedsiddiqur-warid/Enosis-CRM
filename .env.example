# Postgres (Neon / Supabase in production; `npx prisma dev` locally)
DATABASE_URL=""
SHADOW_DATABASE_URL=""

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST=true
AUTH_ALLOWED_DOMAIN="enosisbd.com"
# Dev-only email login (no password). Never enable in production.
AUTH_DEV_LOGIN=false

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Lead-gen / research connectors (optional). Turn each on in Settings → Integrations.
APOLLO_API_KEY=""
LUSHA_API_KEY=""
